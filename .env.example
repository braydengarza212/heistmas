# Heistmas game server settings. Copy to .env and edit, or set these as
# environment variables on your host. Every value below is the default.

# ---------------------------------------------------------------- website
PORT=8080
HOST=0.0.0.0
# Built game the server hosts (npm run build writes it here)
PUBLIC_DIR=dist
# Where accounts, the prize ledger and round history are saved. Use a persistent disk.
DATA_DIR=data
# Set to true behind a proxy/load balancer so per-IP limits see real visitor IPs
TRUST_PROXY=false
# Only if the website is hosted somewhere else than this server, e.g. https://heistmas.example.com
ALLOWED_ORIGINS=
# Secret for GET /api/admin/status (treasury, unpaid prizes, flagged runs). Empty = disabled.
ADMIN_TOKEN=

# ---------------------------------------------------------------- servers
SERVER_COUNT=10
MAX_PLAYERS_PER_SERVER=2000
# Robbers sharing one copy of the bank (a server holds several banks)
BANK_CAPACITY=200
# Optional names, comma separated (falls back to "Server 1", "Server 2", …)
SERVER_NAMES=
MAX_CONNECTIONS_PER_IP=6
REGISTRATIONS_PER_IP_PER_HOUR=5
AUTH_REQUESTS_PER_IP_PER_MINUTE=20
# Extra words not allowed in usernames, comma separated
BLOCKED_NAME_WORDS=

# ---------------------------------------------------------------- rounds
# Length of each race
ROUND_SECONDS=300
# Break between rounds: results, payouts, then the countdown to the next race
INTERMISSION_SECONDS=30
# Players who arrive later than this into a round wait for the next one
LATE_JOIN_SECONDS=60

# ---------------------------------------------------------------- prize pot
# Percent of the pot per place, fastest first. Must not increase and must add up to ≤ 100.
PAYOUT_SPLIT=50,30,20
# Percent of every pot the site keeps (0 = everything goes to the winners)
HOUSE_CUT_PERCENT=0
# Shares smaller than this roll over instead of being sent (must cover rent for new wallets)
MIN_PAYOUT_SOL=0.001
# SOL always left in the dev wallet to pay transaction fees
WALLET_RESERVE_SOL=0.02

# ---------------------------------------------------------------- Solana / pump.fun
# mock = simulated fees and payouts (safe for testing); live = real SOL on Solana
CHAIN_MODE=mock
SOLANA_CLUSTER=mainnet-beta
# Use a paid RPC (Helius, Triton, QuickNode…) in production; the public one is rate limited
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional websocket URL for instant fee notifications (derived from the RPC URL when empty)
SOLANA_WS_URL=
# The dev wallet that collects the creator fees and pays winners: base58 secret key,
# a JSON array of 64 numbers, or a path to a Solana keypair .json file.
# NEVER commit this or put it in the website build.
DEV_WALLET_SECRET_KEY=
# The coin's mint (contract address) on pump.fun
TOKEN_MINT=
TOKEN_NAME=Heistmas
TOKEN_SYMBOL=HEISTMAS
# Extra links on the $HEISTMAS page: Label|https://…, comma separated
TOKEN_LINKS=
# Look for new fees this often (trades also trigger an immediate look)
CLAIM_POLL_SECONDS=10
# Claim once at least this much is waiting…
CLAIM_MIN_SOL=0.002
# …and at most this often (each claim costs a transaction fee)
CLAIM_MIN_INTERVAL_SECONDS=15
# Priority fee for claim and payout transactions (micro-lamports per compute unit)
PRIORITY_FEE_MICROLAMPORTS=50000
# true = log what would be claimed and paid, but send nothing
DRY_RUN=false
# Mock mode only: simulated trading fees per minute
MOCK_FEE_SOL_PER_MINUTE=0.6
# SOL→USD price for showing the pot in dollars (empty = SOL only)
PRICE_URL=https://lite-api.jup.ag/price/v3?ids=So11111111111111111111111111111111111111112

# ---------------------------------------------------------------- run checks
# on = finishes must pass the server's plausibility checks to win. Only turn off for local testing.
ANTICHEAT=on
# No legitimate escape is faster than this (tune it after watching real rounds)
MIN_FINISH_SECONDS=40
# Fastest a player can move between two position samples (m/s), and over 4 seconds
MAX_SPEED=24
MAX_AVG_SPEED=13.5
# Up to this much of a player's measured one-way latency is taken off their time
MAX_LATENCY_COMP_MS=100
